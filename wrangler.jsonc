/**
 * Cloudflare Workers configuration for MyReelo (OpenNext).
 * Do not use @cloudflare/next-on-pages or Vercel for this deploy path.
 *
 * Secrets are set in the Cloudflare dashboard / `wrangler secret put` —
 * never commit real values here.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myreloapp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "myreloapp"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret defaults for the Workers runtime. Put secrets in CF Secrets.
  "vars": {
    "CLOUDFLARE_WORKERS": "1",
    "DISABLE_SQLITE": "1",
    // Neon HTTP from this Worker returns CF 530/1016; use WebSocket Pool instead.
    "NEON_USE_WEBSOCKET": "1"
  },
  // Supabase direct TCP from Workers fails (IPv6-only / CONNECT_TIMEOUT).
  // Hyperdrive proxies Postgres over CF's network — required for auth.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fb7349127d7e4bb699b877d1ec859679"
    }
  ]
}
